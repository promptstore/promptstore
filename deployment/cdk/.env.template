# AWS Account Configuration
CDK_DEFAULT_ACCOUNT="<AWS_ACCOUNT_ID>"
CDK_DEFAULT_REGION="<AWS_REGION>"

# Application Configuration
APP_NAME=promptstore

# S3 Configuration
S3_BUCKET_PREFIX="promptstore-<ENVIRONMENT>"
UPLOAD_BUCKET_NAME="promptstore-<ENVIRONMENT>-data-<AWS_REGION>"

# ECR Configuration
ECR_REPOSITORY_NAME=europalabs/promptstore

# GitHub OIDC Configuration
GITHUB_ORG="<GITHUB_ORG_OR_HANDLE>"
GITHUB_REPO="promptstore"
CREATE_GITHUB_OIDC_PROVIDER=false
EXISTING_GITHUB_OIDC_PROVIDER_ARN="arn:aws:iam::<AWS_ACCOUNT_ID>:oidc-provider/token.actions.githubusercontent.com"

# Existing Tapitriager Infrastructure (import these from tapitriager deployment)
EXISTING_VPC_ID="<VPC_ID>"
EXISTING_EKS_SG_ID="<EKS_SECURITY_GROUP_ID>"
EXISTING_RDS_SG_ID="<RDS_SECURITY_GROUP_ID>"
EXISTING_EKS_OIDC_ISSUER="<EKS_OIDC_ISSUER_URL>"
EXISTING_EKS_OIDC_PROVIDER_ARN="arn:aws:iam::<AWS_ACCOUNT_ID>:oidc-provider/<EKS_OIDC_ISSUER>"

# EKS Admin Role (for kubectl access via SSO)
EKS_ADMIN_ROLE_ARN="arn:aws:iam::<AWS_ACCOUNT_ID>:role/aws-reserved/sso.amazonaws.com/<AWS_REGION>/AWSReservedSSO_AWSAdministratorAccess_<REPLACE_SUFFIX>"
